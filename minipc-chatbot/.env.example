# 미니PC용 (docker compose) — 복사해서 .env 로 사용
COMET_TOKEN=change-me-to-a-long-random-string
# 테일스케일 IP(100.x.y.z)로 지정하면 tailnet 밖에서는 접근 불가
BIND_ADDR=0.0.0.0

# ── A. 미니PC 안의 Ollama 사용 (기본) ──
COMPOSE_PROFILES=ollama
LLM_BACKEND=ollama
CHAT_MODEL=qwen2.5:7b
EMBED_MODEL=bge-m3

# ── B. 워크스테이션의 Ollama 사용 ── (위 COMPOSE_PROFILES 줄을 지우고)
# LLM_BACKEND=ollama
# OLLAMA_URL=http://workstation:11434
# CHAT_MODEL=qwen2.5:32b

# ── C. 워크스테이션의 LM Studio / vLLM / llama.cpp (OpenAI 호환 API) ──
# LLM_BACKEND=openai
# OPENAI_BASE_URL=http://workstation:1234/v1     # LM Studio 기본 포트 1234, vLLM 은 8000
# OPENAI_API_KEY=                                # 서버에 키를 설정했다면 입력
# CHAT_MODEL=qwen2.5-32b-instruct                # 워크스테이션에 로드된 모델 id
# EMBED_MODEL=text-embedding-bge-m3              # 임베딩 모델도 워크스테이션에 로드
